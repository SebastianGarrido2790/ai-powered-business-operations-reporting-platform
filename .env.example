# ==============================================================================
# Business Operations Platform Foundation (BOPF)
# Local Development Environment Configuration (.env.example)
#
# NOTICE:
# - These values are for LOCAL CONTAINERIZED AND HOST DEVELOPMENT ONLY.
# - NEVER commit real credentials, tokens, or production secrets to Git.
# - Copy this file to .env before starting:
#     copy .env.example .env     (Windows CMD)
#     cp .env.example .env       (Bash / PowerShell)
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Runtime Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true
APP_NAME=bopf
APP_VERSION=0.1.0
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# PostgreSQL Persistence Settings
# ------------------------------------------------------------------------------
# HOST & PORT SELECTION:
# - Use 'localhost' when executing migrations or running the app on the host machine.
# - Inside Docker Compose, the API service accesses the database via 'db:5432'.
# - If host port 5432 is already in use by a local PostgreSQL service, set DB_PORT=5433.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=operations

# Optional: Full database connection URI (overrides individual DB_* fields if set)
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/operations

# ------------------------------------------------------------------------------
# Sourcing Operations Settings
# ------------------------------------------------------------------------------
SOURCING_SOURCES_FILE=config/sourcing/sources.yaml
SOURCING_LANDING_DIR=data/sourcing/landing
SOURCING_MAX_UPLOAD_BYTES=52428800
SOURCING_MAX_FILE_ROWS=100000
SOURCING_MAX_DB_ROWS=50000
SOURCING_CONNECTOR_TIMEOUT_SECONDS=30.0
SOURCING_MAX_REST_PAGES=100
SOURCING_LANDING_RETENTION_HOURS=24
SOURCING_RAW_PAYLOAD_MAX_BYTES=262144
SOURCING_INGESTION_BUDGET_SECONDS=240
SOURCING_INGESTION_BUDGET_CHECK_RECORDS=1000

