# ==============================================================================
# Business Operations Platform Foundation (BOPF)
# Local Development Environment Configuration (.env.example)
#
# NOTICE:
# - These values are for LOCAL CONTAINERIZED AND HOST DEVELOPMENT ONLY.
# - NEVER commit real credentials, tokens, or production secrets to Git.
# - Copy this file to .env before starting:
#     copy .env.example .env     (Windows CMD)
#     cp .env.example .env       (Bash / PowerShell)
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Runtime Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true
APP_NAME=bopf
APP_VERSION=0.1.0
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# PostgreSQL Persistence Settings
# ------------------------------------------------------------------------------
# HOST SELECTION:
# - Use 'localhost' when executing migrations or running the app on the host machine.
# - Use 'db' when executing inside the Docker Compose bridge network.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=operations

# Optional: Full database connection URI (overrides individual DB_* fields if set)
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/operations
